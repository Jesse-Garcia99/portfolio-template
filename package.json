{
  "name": "portfolio-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "NODE_ENV=production tinacms build --local --skip-cloud-checks -c \"next build\"",
    "build:cloud": "tinacms build -c \"next build\"",
    "start": "next start",
    "lint": "tsc --noEmit",
    "audit:seo": "node scripts/audit-seo.mjs",
    "pages:dev": "npm run build && wrangler pages dev out",
    "pages:deploy": "npm run build && wrangler pages deploy out"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "motion": "^13.2.0",
    "next": "^15.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinacms": "^3.8.4"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.4.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
