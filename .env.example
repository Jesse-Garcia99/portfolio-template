# Copy to .env.local and fill in. Never commit real values.

# Cloudflare — only needed to deploy from your own machine. In CI these come
# from the repository secrets of the same name, not from this file.
# Token permission required: Account > Cloudflare Pages > Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# TinaCMS Cloud (optional — only needed for the /admin editor).
# Create a project at https://app.tina.io, then copy its Client ID here.
NEXT_PUBLIC_TINA_CLIENT_ID=
# Secret. app.tina.io > your project > Tokens. A read-only token is enough to build.
TINA_TOKEN=
TINA_BRANCH=main
